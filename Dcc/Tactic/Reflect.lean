namespace _test

open Lean Elab

#check MetaExpr.decode
#check Expr.decode

def test_decode : TermElabM _root_.Expr := do
  let test := toExpr (DCC (Id(Sort 1) Sort 0))
  Expr.decode test

#eval test_decode

def test_decode' : TermElabM MetaExpr := do
  let test := toExpr (DCC (Id(Sort 1) Sort 0))
  MetaExpr.decode test

#eval test_decode'

def test_decode''' : TermElabM MetaExpr := do
  let test := toExpr (DCC[Expr] (Id(Sort 1) Sort 0))
  MetaExpr.decode test

#eval test_decode'''

def test_decode'' : TermElabM MetaExpr := do
  let test := Lean.Expr.app (.const ``Expr.id []) (.const `garbage_name [])
  MetaExpr.decode test

#eval test_decode''

def test_encode   : Lean.Expr :=
  let expr : MetaExpr := DCC[MetaExpr] Id(#(MetaExpr.lean_expr (Lean.Expr.const `garbage [])))
  expr.encode

#eval test_encode

end _test

