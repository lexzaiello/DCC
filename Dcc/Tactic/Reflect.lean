def mk_decode (flags : Flag) : MacroM (TSyntax `command) := do
  let fun_name ← flags.def_field "decode"
  let my_name ← flags.as!'
  let quot_field (fld : String) : MacroM (TSyntax `term) :=
    let field := field fld
    `(.const ``_root_.$(my_name).$(field) [])

  let quoted_fields : Array (TSyntax `term → TSyntax ``matchAltExpr) :=
    #[(`( 

  `(command|
    def $fun_name (e : Lean.Expr) : Lean.Elab.Term.TermElabM $my_name := do
    match e with
    | .app $sort m =>
      let some n ← (pure m.nat?) | throwError s!"unsupported: {m}"
      return .sort n
    | .const ``_root_.Expr.top [] =>
      return .top
    | .const ``_root_.Expr.bot [] =>
      return .bot
    | .const ``_root_.Expr.tintro [] =>
      return .tintro
    | .app (.const ``_root_.Expr.sndc []) β =>
      let β' ← decode_dcc β
      return .sndc β'
    | .app (.const ``_root_.Expr.fstc []) β =>
      let β' ← decode_dcc β
      return .fstc β'
    | .app (.const ``_root_.Expr.coup []) β =>
      let β' ← decode_dcc β
      return .coup β'
    | .app (.app (.const ``_root_.Expr.sigma []) α) β =>
      let α' ← decode_dcc α
      let β' ← decode_dcc β
      return .sigma α' β'
    | .app (.const ``_root_.Expr.id []) α =>
      let α' ← decode_dcc α
      return .id α'
    | .app (.app (.const ``_root_.Expr.comp []) f) g =>
      let f ← decode_dcc f
      let g ← decode_dcc g
      return .comp f g
    | .app (.app (.const ``_root_.Expr.pair []) f) g =>
      let f ← decode_dcc f
      let g ← decode_dcc g
      return .pair f g
    | .app (.app (.app (.const ``_root_.Expr.mk []) β) x) y =>
      let β ← decode_dcc β
      let x ← decode_dcc x
      let y ← decode_dcc y
      return .mk β x y
    | .app (.app (.const ``_root_.Expr.pi []) f_α) f_β =>
      let f_α ← decode_dcc f_α
      let f_β ← decode_dcc f_β
      return .pi f_α f_β
    | .app (.app (.app (.const ``_root_.Expr.curr []) α) β) x =>
      let α ← decode_dcc α
      let β ← decode_dcc β
      let x ← decode_dcc x
      return .curr α β x
    | .app (.app (.const ``_root_.Expr.quot []) β) x =>
      let β ← decode_dcc β
      let x ← decode_dcc x
      return .quot β x
    | .app (.app (.const ``_root_.Expr.app []) f) x =>
      let f ← decode_dcc f
      let x ← decode_dcc x
      return .app f x
    | e => throwError s!"unsupported: {e}")

syntax "gen_reflect" gen_flag_set : command

open GenAst Lean Elab in
macro_rules
