import Dcc.Ast
import Dcc.Relation

/-
Conversion to / from Lean.Expr for any instance of the AST
(i.e., anything generated by gen_ast).
-/

syntax "gen_reflect" gen_flag_set : command

open GenAst Lean Elab in
macro_rules
  | `(gen_reflect $flags:gen_flag_set) => do
    let pflags := parse_flags flags
    sorry
