/-
Conversion to / from Lean.Expr for any instance of the AST
(i.e., anything generated by gen_ast).

use base_ctors and ext_ctors for my_name to

hand-written decoder:
- Debug.dcc

deriving Lean.ToExpr helps
-/

open GenAst Lean Meta Macro
open Lean Parser Term

open Lean.Parser.Term (matchAlt)
open Lean.Parser.Term (implicitBinder)

/-
adding custom handlers for the extensions of a generated
inductive.

these are terminal nodes. all other nodes are just normal nodes,
and we handle them as always.

we are matching on a meta term here, not a quoted expr.
-/

-- then_do specifies how to handle children of the node
-- the recursor
def AstField.to_lean (then_do : TSyntax `term → MacroM (TSyntax `term))
  (flags : Flag) (fld : AstField) : MacroM (TSyntax ``matchAlt) := do
  let lean_app : TSyntax `ident := mkIdent ``Lean.Expr.app
  let nm_long := fld.nm_long (← flags.get!' Flag.from?)
  let nm_quot ← fld.nm_quoted (← flags.get!' Flag.from?)
  let vars : List (TSyntax `ident) := (List.range fld.total_arity).map (fun n =>
      let idt : TSyntax `ident := mkIdent (Name.str .anonymous s!"x_{n}").eraseMacroScopes
      idt)
  let bdr ← `(term| $nm_long:ident $(⟨vars⟩)*)

  let mut_vars ← if fld.is_ext then
    vars.mapM (fun e => `(term| Lean.ToExpr.toExpr $e:term))
  else vars.mapM then_do

  let bdy ← mut_vars.foldlM (init := ← `(term| $nm_quot))
      (fun (acc : TSyntax `term) (e : TSyntax `term) => `(term| $lean_app $acc:term $e:term))

  `(matchAltExpr| | $bdr => $bdy:term)

def mk_encode (flags : Flag) (base_fields : Array AstField) (ind_arity : ℕ := 0) : MacroM (TSyntax `command) := do
  let my_ext    := flags.ext_fields
  let my_attrs  ← flags.attrs
  let my_name   ← flags.get!' Flag.from?
  let fun_name  ← flags.def_field "encode" Flag.from?

  let ext_matches : Array (TSyntax ``matchAlt) ← my_ext.mapM (fun fld =>
    -- If this is already a Lean.Expr, do not quot it again
    let nm := fld.nm_long my_name
    if fld.nm == "lean_expr" then
      `(matchAltExpr| | $nm x => x)
    else `(matchAltExpr| | $nm x => Lean.ToExpr.toExpr x))

  let then_do (child_e : TSyntax `term) : MacroM (TSyntax `term) :=
    `(term| $fun_name $child_e)

  let base_matches : Array (TSyntax ``matchAlt) ← base_fields.mapM (AstField.to_lean then_do flags)

  let matchers := base_matches ++ ext_matches

  match ind_arity with
  | .zero =>
    `(command|
      @[$my_attrs]
      def $fun_name (e : $my_name) : Lean.Expr :=
        match e with
        $(matchers):matchAlt*)
  | n@(.succ _) =>
    let vars : List (TSyntax `ident) := (List.range n).map (fun n =>
      let idt : TSyntax `ident := mkIdent (Name.str .anonymous s!"x_{n}").eraseMacroScopes
      idt)
    let bdrs : List (TSyntax ``bracketedBinder) ← vars.mapM (fun v => `(bracketedBinder| {$v : _}))
    `(command|
      @[$my_attrs]
      def $fun_name $(⟨bdrs⟩)* (e : $my_name $(⟨vars⟩)*) : Lean.Expr :=
        match e with
        $(matchers):matchAlt*)

def mk_decode (flags : Flag) : MacroM (TSyntax `command) := do
  let my_attrs  ← flags.attrs
  let my_name   ← flags.as!'
  let fun_name  ← flags.def_field "decode"
  let do_with : TSyntax `term ← `(term| $fun_name:term)
  let get_matcher := AstField.meta_matcher (rec_handler := do_with) flags
  let otherwise : Array (TSyntax ``matchAlt) ← do
    if flags.has_wild_card then
      pure #[]
    else pure #[← `(matchAltExpr| | e => throwError m!"this is not an expr: {e}")]
  let matchers : Array (TSyntax ``matchAlt) := (← (← flags.all_fields).mapM get_matcher)
    ++ otherwise

  let cmd ← `(command|
    @[$my_attrs]
    def $fun_name (e : Lean.Expr) : Lean.Elab.Term.TermElabM $my_name :=
      match e with
      $(matchers):matchAlt*)
  return cmd

end GenAst

syntax "gen_decode" gen_flag_set : command
syntax "gen_encode" gen_flag_set : command

open GenAst Lean Elab in
macro_rules
  | `(gen_decode $flags:gen_flag_set) => mk_decode (parse_flags flags)
  | `(gen_encode $flags:gen_flag_set) => do mk_encode (parse_flags flags) (← ast_base_fields)

open GenAst in
def dedup_fields (ext_fields fields : Array AstField) : Array AstField :=
  fields.filter (fun f => (ext_fields.find? (fun f' => f'.nm == f.nm)).isNone)

open GenAst Lean Elab in
open Lean.Elab.Command in
open Lean.Elab.Term in
elab "gen_encode'" flags:gen_flag_set : command => do
  let flags := parse_flags flags
  let src   ← flags.get! Flag.from?
  let nm := src.getId
  let ext_fields := flags.ext_fields
  let (found_flags, found_fields) ← liftTermElabM <| get_def_flags nm
  let n_idx ← found_flags.get! Flag.n_indexes
  let all_flags := flags ++ found_flags
  let all_fields := dedup_fields ext_fields found_fields
  let cmd ← liftMacroM <| mk_encode all_flags all_fields n_idx
  elabCommand cmd

gen_decode from Expr
  as MetaExpr
  sort decoded_by decode_level
  with Lean.Expr *

gen_decode from Expr
  as Expr
  sort decoded_by decode_level

gen_encode from MetaExpr
  as Expr
  with Lean.Expr *

gen_encode'
  from MetaExpr.RedAffMeta
  as RedAff
  sort decoded_by decode_level
  with Lean.Expr *

